<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageClassifierApp.ViewModels"
        x:Class="ImageClassifierApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Digit Classifier AI" 
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid RowDefinitions="Auto, *, Auto" Margin="30">
        
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
            <TextBlock Text="Handwritten Digit AI" 
                       FontSize="24" FontWeight="SemiBold" 
                       Foreground="#333333" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding PredictionResult}" 
                       FontSize="14" Foreground="#666666" 
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
            
            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsBusy}" 
                         Height="2" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" 
                CornerRadius="12" 
                Background="White" 
                BoxShadow="0 4 10 0 #20000000"
                ClipToBounds="True">
            <Panel>
                <TextBlock Text="No Image Selected" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#CCCCCC"
                           IsVisible="{Binding SelectedImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                
                <Image Source="{Binding SelectedImage}" 
                       Stretch="Uniform" 
                       Margin="20"/>
            </Panel>
        </Border>

        <Button Grid.Row="2" 
                Content="Upload Digit" 
                Command="{Binding SelectImageCommand}"
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Padding="15" Margin="0,20,0,0"
                Background="#007AFF" Foreground="White"
                CornerRadius="8">
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#0062CC"/>
                </Style>
            </Button.Styles>
        </Button>

    </Grid>
</Window>
