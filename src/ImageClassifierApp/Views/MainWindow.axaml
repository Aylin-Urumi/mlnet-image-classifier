<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageClassifierApp.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        x:Class="ImageClassifierApp.Views.MainWindow"
        Title="ML.NET Image Classifier"
        Width="500" Height="600"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="ML.NET Image Classifier" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center"/>
        
        <Border BorderBrush="Gray" BorderThickness="2" CornerRadius="10" Height="300">
            <Image Source="{Binding SelectedImage}" Stretch="Uniform" />
        </Border>

        <TextBlock Text="{Binding PredictionResult}" 
                   FontSize="18" Foreground="Green"
                   HorizontalAlignment="Center" FontWeight="SemiBold"/>

        <Button Content="Upload &amp; Classify" 
                Command="{Binding SelectImageCommand}"
                HorizontalAlignment="Center" Padding="20,10"
                Classes="accent" />
    </StackPanel>
</Window>
