<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageClassifierApp.ViewModels"
        x:Class="ImageClassifierApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Digit Classifier AI" 
        Height="650" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid RowDefinitions="Auto, *, Auto" Margin="30">
        
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,10">
            <TextBlock Text="Handwritten Digit AI" 
                       FontSize="24" FontWeight="SemiBold" 
                       Foreground="#333333" HorizontalAlignment="Center"/>
            
            <Border Background="#E8E8E8" CornerRadius="10" Padding="15" Margin="0,15,0,5">
                <TextBlock Text="{Binding PredictionResult}" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#007AFF"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>
            
            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsBusy}" 
                         Height="2" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" 
                CornerRadius="12" 
                Background="White" 
                BoxShadow="0 4 10 0 #20000000"
                ClipToBounds="True">
            <Panel>
                <TextBlock Text="No Image Selected" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#CCCCCC"
                           IsVisible="{Binding SelectedImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                
                <Image Source="{Binding SelectedImage}" 
                       Stretch="Uniform" 
                       Margin="20"/>
            </Panel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">
            
            <Button Content="Upload The Image"
                    Command="{Binding SelectImageCommand}"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Padding="15"
                    Background="#007AFF" Foreground="White"
                    CornerRadius="8">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#0062CC"/>
                    </Style>
                </Button.Styles>
            </Button>

            <Button Content="Clear"
                    Command="{Binding ClearCommand}"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Padding="15"
                    Background="#E74C3C" Foreground="White"
                    CornerRadius="8">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#C0392B"/>
                    </Style>
                </Button.Styles>
            </Button>
            
        </StackPanel>

    </Grid>
</Window>
